{
  "description": "Week 5: return failure context after command execution. Review and trust this definition, and confirm the matcher against the actual tool name.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "java --class-path \".local/hook-runtime/*\" \".codex/hooks/PostToolUseReview.java\"",
            "commandWindows": "java --class-path \".local/hook-runtime/*\" \".codex/hooks/PostToolUseReview.java\"",
            "timeout": 30,
            "statusMessage": "Reviewing command result"
          }
        ]
      }
    ]
  }
}
